{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "AgentSecBench",
          "version": "0.2.0",
          "informationUri": "https://github.com/A1LinLin1/AgentSecBench",
          "rules": [
            {
              "id": "agentsecbench/browser_control",
              "name": "browser_control",
              "shortDescription": {
                "text": "Browser Control"
              },
              "fullDescription": {
                "text": "Browser automation framework reference"
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "precision": "medium",
                "tags": [
                  "security",
                  "llm-agent",
                  "static-analysis",
                  "browser_control"
                ]
              }
            },
            {
              "id": "agentsecbench/command_execution",
              "name": "command_execution",
              "shortDescription": {
                "text": "Command Execution"
              },
              "fullDescription": {
                "text": "Python subprocess invocation; Shell interpreter reference"
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "precision": "high",
                "tags": [
                  "security",
                  "llm-agent",
                  "static-analysis",
                  "command_execution"
                ]
              }
            },
            {
              "id": "agentsecbench/credential_access",
              "name": "credential_access",
              "shortDescription": {
                "text": "Credential Access"
              },
              "fullDescription": {
                "text": "Credential-like environment access"
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "precision": "high",
                "tags": [
                  "security",
                  "llm-agent",
                  "static-analysis",
                  "credential_access"
                ]
              }
            },
            {
              "id": "agentsecbench/database_access",
              "name": "database_access",
              "shortDescription": {
                "text": "Database Access"
              },
              "fullDescription": {
                "text": "Database client or query API reference"
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "precision": "medium",
                "tags": [
                  "security",
                  "llm-agent",
                  "static-analysis",
                  "database_access"
                ]
              }
            },
            {
              "id": "agentsecbench/external_tool_invocation",
              "name": "external_tool_invocation",
              "shortDescription": {
                "text": "External Tool Invocation"
              },
              "fullDescription": {
                "text": "CrewAI tool or agent binding; LangChain tool or agent-tool binding; MCP or agent tool definition"
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "precision": "high",
                "tags": [
                  "security",
                  "llm-agent",
                  "static-analysis",
                  "external_tool_invocation"
                ]
              }
            },
            {
              "id": "agentsecbench/filesystem_delete",
              "name": "filesystem_delete",
              "shortDescription": {
                "text": "Filesystem Delete"
              },
              "fullDescription": {
                "text": "Python filesystem deletion"
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "precision": "high",
                "tags": [
                  "security",
                  "llm-agent",
                  "static-analysis",
                  "filesystem_delete"
                ]
              }
            },
            {
              "id": "agentsecbench/filesystem_read",
              "name": "filesystem_read",
              "shortDescription": {
                "text": "Filesystem Read"
              },
              "fullDescription": {
                "text": "JavaScript or TypeScript file-read operation; Python file-read operation"
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "precision": "high",
                "tags": [
                  "security",
                  "llm-agent",
                  "static-analysis",
                  "filesystem_read"
                ]
              }
            },
            {
              "id": "agentsecbench/filesystem_write",
