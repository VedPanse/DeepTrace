                "text": "Filesystem Write"
              },
              "fullDescription": {
                "text": "Python file-write operation"
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "precision": "high",
                "tags": [
                  "security",
                  "llm-agent",
                  "static-analysis",
                  "filesystem_write"
                ]
              }
            },
            {
              "id": "agentsecbench/network_access",
              "name": "network_access",
              "shortDescription": {
                "text": "Network Access"
              },
              "fullDescription": {
                "text": "Direct socket connection; JavaScript or TypeScript HTTP request"
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "precision": "high",
                "tags": [
                  "security",
                  "llm-agent",
                  "static-analysis",
                  "network_access"
                ]
              }
            }
          ]
        }
