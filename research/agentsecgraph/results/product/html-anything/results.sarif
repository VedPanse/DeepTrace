{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "AgentSecBench",
          "version": "0.2.0",
          "informationUri": "https://github.com/A1LinLin1/AgentSecBench",
          "rules": [
            {
              "id": "agentsecbench/browser_control",
              "name": "browser_control",
              "shortDescription": {
                "text": "Browser Control"
              },
              "fullDescription": {
                "text": "Browser automation framework reference"
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "precision": "medium",
                "tags": [
                  "security",
                  "llm-agent",
                  "static-analysis",
                  "browser_control"
                ]
              }
            },
            {
              "id": "agentsecbench/command_execution",
              "name": "command_execution",
              "shortDescription": {
                "text": "Command Execution"
              },
              "fullDescription": {
                "text": "JavaScript or TypeScript process invocation candidate"
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "precision": "medium",
                "tags": [
                  "security",
                  "llm-agent",
                  "static-analysis",
                  "command_execution"
                ]
              }
            },
            {
              "id": "agentsecbench/filesystem_delete",
              "name": "filesystem_delete",
              "shortDescription": {
                "text": "Filesystem Delete"
              },
              "fullDescription": {
                "text": "JavaScript or TypeScript filesystem deletion candidate"
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "precision": "medium",
                "tags": [
                  "security",
                  "llm-agent",
                  "static-analysis",
                  "filesystem_delete"
                ]
              }
            },
            {
              "id": "agentsecbench/filesystem_read",
              "name": "filesystem_read",
              "shortDescription": {
                "text": "Filesystem Read"
              },
              "fullDescription": {
                "text": "JavaScript or TypeScript file-read operation"
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "precision": "high",
                "tags": [
                  "security",
                  "llm-agent",
                  "static-analysis",
                  "filesystem_read"
                ]
              }
            },
            {
              "id": "agentsecbench/filesystem_write",
              "name": "filesystem_write",
              "shortDescription": {
                "text": "Filesystem Write"
              },
              "fullDescription": {
                "text": "JavaScript or TypeScript file-write operation"
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "precision": "high",
                "tags": [
                  "security",
                  "llm-agent",
                  "static-analysis",
                  "filesystem_write"
                ]
              }
            },
            {
              "id": "agentsecbench/network_access",
              "name": "network_access",
              "shortDescription": {
                "text": "Network Access"
              },
              "fullDescription": {
                "text": "JavaScript or TypeScript HTTP request"
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "precision": "high",
                "tags": [
                  "security",
                  "llm-agent",
                  "static-analysis",
                  "network_access"
                ]
              }
            }
          ]
        }
      },
