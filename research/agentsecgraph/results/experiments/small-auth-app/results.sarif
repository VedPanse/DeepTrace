{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "AgentSecBench",
          "version": "0.2.0",
          "informationUri": "https://github.com/A1LinLin1/AgentSecBench",
          "rules": [
            {
              "id": "agentsecbench/credential_access",
              "name": "credential_access",
              "shortDescription": {
                "text": "Credential Access"
              },
              "fullDescription": {
                "text": "Credential-like environment access"
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "precision": "high",
                "tags": [
                  "security",
                  "llm-agent",
                  "static-analysis",
                  "credential_access"
                ]
              }
            },
            {
              "id": "agentsecbench/network_access",
              "name": "network_access",
              "shortDescription": {
                "text": "Network Access"
              },
              "fullDescription": {
                "text": "JavaScript or TypeScript HTTP request"
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "precision": "high",
                "tags": [
                  "security",
                  "llm-agent",
                  "static-analysis",
                  "network_access"
                ]
              }
            }
          ]
        }
      },
      "originalUriBaseIds": {
        "%SRCROOT%": {
          "uri": "./"
        }
      },
      "results": [
        {
          "ruleId": "agentsecbench/network_access",
          "level": "warning",
          "message": {
            "text": "network access candidate in audit"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "app.ts",
                  "uriBaseId": "%SRCROOT%"
                },
                "region": {
                  "startLine": 6,
                  "endLine": 6
                }
              }
            }
          ],
          "partialFingerprints": {
            "agentsecbenchFindingId/v1": "ASB-0FD132A099F898CD",
            "agentsecbenchStableFingerprint/v1": "ASBFP-DCCAA3A90DCF8831E0107DAE"
          },
          "properties": {
            "candidateId": "ASB-0FD132A099F898CD",
            "fingerprint": "ASBFP-DCCAA3A90DCF8831E0107DAE",
            "confidence": "high",
            "detectors": [
              "js_http_client"
            ],
            "reviewStatus": "candidate",
            "claimBoundary": "static candidate; review required; not a vulnerability claim"
          }
        },
        {
          "ruleId": "agentsecbench/credential_access",
          "level": "warning",
          "message": {
            "text": "credential access candidate in secret"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "app.ts",
                  "uriBaseId": "%SRCROOT%"
                },
                "region": {
                  "startLine": 9,
                  "endLine": 9
                }
              }
            }
          ],
          "partialFingerprints": {
            "agentsecbenchFindingId/v1": "ASB-73723BD5887AF9B4",
            "agentsecbenchStableFingerprint/v1": "ASBFP-8CE7BB043C22FD45EAA588FC"
          },
          "properties": {
            "candidateId": "ASB-73723BD5887AF9B4",
            "fingerprint": "ASBFP-8CE7BB043C22FD45EAA588FC",
            "confidence": "high",
            "detectors": [
              "environment_secret"
            ],
            "reviewStatus": "candidate",
            "claimBoundary": "static candidate; review required; not a vulnerability claim"
          }
        }
      ],
      "properties": {
        "claimBoundary": "candidate discovery output; not vulnerability ground truth",
        "sourceExecutionUsed": false
      }
    }
  ]
}
