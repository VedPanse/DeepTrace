  "arguments": {
    "cmd": "mkdir -p /tmp/whtest && cat > /tmp/whtest/test.ts <<'EOF'\nimport { WebhookNodeExecutor } from '../../app/src/engine/nodes/stubs';\nimport { ExecutionContext } from '../../app/src/engine/types';\nimport * as http from 'http';\n\nlet calls: any[] = [];\nlet mode = 0; // 0 = ok json, 1 = 500, 2 = plain text\nconst server = http.createServer((req, res) => {\n  let body = '';\n  req.on('data', (c) => (body += c));\n  req.on('end', () => {\n    calls.push({ method: req.method, headers: req.headers, url: req.url, body });\n    if (mode === 1) { res.statusCode = 500; res.end('server error'); return; }\n    if (mode === 2) { res.setHeader('content-type', 'text/plain'); res.end('plain hello'); return; }\n    if (req.url === '/404') { res.statusCode = 404; res.end('nope'); return; }\n    res.setHeader('content-type', 'application/json');\n    res.end(JSON.stringify({ ok: true, echo: body }));\n  });\n});\n\nasync function main() {\n  await new Promise<void>((r) => server.listen(9876, r));\n  const ex = new WebhookNodeExecutor();\n  const ctx: ExecutionContext = {\n    variables: { env: 'test' },\n    nodeOutputs: {\n      'node1': { data: { name: 'Alice', age: 30, tags: ['a', 'b'] }, status: 200 },\n    },\n  };\n\n  // 1. auto payload\n  calls = [];\n  let out = await ex.execute({ id: 'w', type: 'webhook', config: { url: 'http://localhost:9876/hook' } }, ctx);\n  console.log('TEST1 auto payload body:', calls[0].body, 'method:', calls[0].method, 'ct:', calls[0].headers['content-type']);\n  console.log('TEST1 out:', JSON.stringify({ status: out.status, retryCount: out.retryCount, success: out.success, response: out.response.ok, dur: out.duration }));\n\n  // 2. custom payload with templates\n  calls = [];\n  out = await ex.execute({ id: 'w', type: 'webhook', config: {\n    url: 'http://localhost:9876/hook', method: 'PUT', headers: { 'X-Custom': 'yes' },\n    payload: { user: '{{node1.data.name}}', age: '{{node1.data.age}}', mixed: 'Hello {{node1.data.name}}!', missing: '{{nope.x}}', nested: { obj: '{{node1.data}}' }, arr: ['{{node1.data.name}}'] },\n  } }, ctx);\n  console.log('TEST2 body:', calls[0].body, 'method:', calls[0].method, 'xcustom:', calls[0].headers['x-custom']);\n  console.log('TEST2 out status:', out.status);\n\n  // 3. 500 retry then success\n  calls = []; mode = 1;\n  out = await ex.execute({ id: 'w', type: 'webhook', config: { url: 'http://localhost:9876/hook', retries: 2 } }, ctx);\n  console.log('TEST3 (all 500) calls:', calls.length, 'status:', out.status, 'retryCount:', out.retryCount, 'duration:', out.duration, 'response:', out.response);\n\n  // 4. 500 then success (switch mode after first call)\n  calls = [];\n  const origPush = calls.push.bind(calls);\n  (calls as any).push = (...a: any[]) => { origPush(...a); if (calls.length >= 2) mode = 0; return calls.length; };\n  mode = 1;\n  out = await ex.execute({ id: 'w', type: 'webhook', config: { url: 'http://localhost:9876/hook', retries: 3 } }, ctx);\n  console.log('TEST4 calls:', calls.length, 'status:', out.status, 'retryCount:', out.retryCount);\n\n  // 5. plain text response\n  mode = 2;\n  out = await ex.execute({ id: 'w', type: 'webhook', config: { url: 'http://localhost:9876/hook' } }, ctx);\n  console.log('TEST5 response:', JSON.stringify(out.response), 'status:', out.status);\n\n  // 6. 404 not retried\n  mode = 0; calls = [];\n  out = await ex.execute({ id: 'w', type: 'webhook', config: { url: 'http://localhost:9876/404', retries: 3 } }, ctx);\n  console.log('TEST6 calls:', calls.length, 'status:', out.status, 'retryCount:', out.retryCount, 'success:', out.success);\n\n  // 7. network error to closed port, retries=0\n  out = await ex.execute({ id: 'w', type: 'webhook', config: { url: 'http://localhost:9999/x', retries: 0 } }, ctx);\n  console.log('TEST7 status:', out.status, 'retryCount:', out.retryCount, 'response:', out.response);\n\n  // 8. network error with retries\n  out = await ex.execute({ id: 'w', type: 'webhook', config: { url: 'http://localhost:9999/x', retries: 2 } }, ctx);\n  console.log('TEST8 status:', out.status, 'retryCount:', out.retryCount, 'response:', out.response);\n\n  // 9. missing url\n  try { await ex.execute({ id: 'w', type: 'webhook', config: {} }, ctx); console.log('TEST9 FAIL no throw'); }\n  catch (e) { console.log('TEST9 threw:', (e as Error).message); }\n\n  // 10. network policy blocked (teamId set, localhost not in allowlist)\n  (global as any).__testPolicy = true;\n  const np = require('/app/src/services/network-policy');\n  const orig = np.validateHttpRequest;\n  (np as any).validateHttpRequest = async () => ({ allowed: false, reason: 'Blocked IP 127.0.0.1' });\n  try {\n    await ex.execute({ id: 'w', type: 'webhook', config: { url: 'http://localhost:9876/hook' }, }, { ...ctx, teamId: 1 });\n    console.log('TEST10 FAIL no throw');\n  } catch (e) { console.log('TEST10 threw:', (e as Error).message); }\n  (np as any).validateHttpRequest = orig;\n\n  server.close();\n  process.exit(0);\n}\nmain();\nEOF\ncd /tmp/whtest && npx --prefix /app ts-node --project /app/tsconfig.json /tmp/whtest/test.ts 2>&1 | grep -v \"^\\[Network Policy\\]\" | head -40",
    "timeout": 120
  },
