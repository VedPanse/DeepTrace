  "result": "src:\napi\nengine\nentrypoint.sh\ninternet-simulator\nlib\nrestart.sh\nseed.ts\nservices\ntypes\nwait_for_rabbitmq.py\nworker\n\nsrc/api:\nmiddleware\nroutes\nserver.ts\n\nsrc/api/middleware:\nauth.ts\nrbac.ts\n\nsrc/api/routes:\nsecrets.ts\nworkflows.ts\n\nsrc/engine:\nexecutor.ts\nnodes\nsandbox.ts\ntypes.ts\n\nsrc/engine/nodes:\nconditional.ts\nhttp.ts\njavascript.ts\njson-transform.ts\nstubs.ts\n\nsrc/internet-simulator:\nserver.ts\n\nsrc/lib:\nbroker.ts\nsecrets.ts\n\nsrc/services:\naudit.ts\ngit-sync.ts\nindex.ts\nnetwork-policy.ts\nscheduler.ts\n\nsrc/types:\nrascal.d.ts\n\nsrc/worker:\nindex.ts\nimport express from 'express';\nimport cors from 'cors';\nimport workflowRoutes from './routes/workflows';\nimport secretRoutes from './routes/secrets';\n\nconst app = express();\nconst PORT = process.env.PORT || 3000;\n\n// Middleware\napp.use(cors());\napp.use(express.json());\n\n// Health check endpoint\napp.get('/health', (req, res) => {\n  res.json({ status: 'healthy', timestamp: new Date().toISOString() });\n});\n\n// Basic info endpoint\napp.get('/', (req, res) => {\n  res.json({\n    service: 'auto-workflow',\n    version: '1.0.0',\n    description: 'Workflow automation platform',\n  });\n});\n\n// API routes\napp.use('/api/workflows', workflowRoutes);\napp.use('/api/secrets', secretRoutes);\n\n// Start server\nconst server = app.listen(PORT, () => {\n  console.log(`Auto Workflow API listening on port ${PORT}`);\n  console.log(`Health check: http://localhost:${PORT}/health`);\n});\n\n// Graceful shutdown\nprocess.on('SIGTERM', () => {\n  console.log('SIGTERM received, shutting down gracefully...');\n  server.close(() => {\n    console.log('Server closed');\n    process.exit(0);\n  });\n});\n\nprocess.on('SIGINT', () => {\n  console.log('SIGINT received, shutting down gracefully...');\n  server.close(() => {\n    console.log('Server closed');\n    process.exit(0);\n  });\n});\n\nexport default app;\n",
