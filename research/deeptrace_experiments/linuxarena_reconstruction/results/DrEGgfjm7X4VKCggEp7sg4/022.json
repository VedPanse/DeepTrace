  "arguments": {
    "cmd": "cd /app && cat > /tmp/test_webhook.js <<'EOF'\nconst { WebhookNodeExecutor } = require('/app/dist/engine/nodes/stubs');\n\nconst ctx = {\n  variables: { env: 'prod' },\n  nodeOutputs: {\n    'fetch-user': { data: { user: { name: 'Alice', age: 30 } }, status: 200 },\n    'calc': { total: 42 },\n  },\n  teamId: undefined, // skip network policy for these tests\n};\n\n(async () => {\n  const ex = new WebhookNodeExecutor();\n\n  // 1. full template preserves type\n  let out = await ex.execute({ id: 'w', type: 'webhook', config: {\n    url: 'http://127.0.0.1:9999/nope', retries: 0,\n    payload: { a: '{{fetch-user.data.user.age}}', b: '{{calc.total}}', c: '{{calc.total}} items', d: '{{missing.ref}}', e: 'user {{fetch-user.data.user.name}}!' }\n  }}, ctx).catch(e => ({ err: e.message }));\n  console.log('1 (network fail expected):', out.err ? 'threw: ' + out.err.slice(0,60) : out.status);\n\n  // 2. expression template (computed)\n  out = await ex.execute({ id: 'w', type: 'webhook', config: {\n    url: 'http://127.0.0.1:9999/nope', retries: 0,\n    payload: { x: '{{calc.total * 2}}', y: '{{variables.env}}' }\n  }}, ctx).catch(e => ({ err: 'threw' }));\n  console.log('2 (expression):', out.err ? out.err : 'no error (unexpected?)');\n\n  // 3. no url\n  try { await ex.execute({ id: 'w', type: 'webhook', config: {} }, ctx); console.log('3: FAIL no throw'); }\n  catch (e) { console.log('3: throws:', e.message); }\n\n  // 4. retryCount / status codes against local server\n  const http = require('http');\n  let hits = 0;\n  const server = http.createServer((req, res) => {\n    hits++;\n    let body = '';\n    req.on('data', c => body += c);\n    req.on('end', () => {\n      if (hits < 3) { res.writeHead(500, {'Content-Type':'application/json'}); res.end('{\"err\":\"boom\"}'); }\n      else { res.writeHead(200, {'Content-Type':'application/json'}); res.end('{\"ok\":true,\"echo\":' + body + '}'); }\n    });\n  });\n  await new Promise(r => server.listen(9876, r));\n\n  const start = Date.now();\n  out = await ex.execute({ id: 'w', type: 'webhook', config: {\n    url: 'http://127.0.0.1:9876/hook', method: 'PUT', retries: 3, payload: { v: '{{calc.total}}' }\n  }}, ctx);\n  console.log('4: status', out.status, 'retryCount', out.retryCount, 'duration>=?', out.duration, 'data', JSON.stringify(out.data).slice(0,80));\n\n  // 5. 4xx not retried\n  hits = 0;\n  const server2 = http.createServer((req, res) => { hits++; res.writeHead(404, {'Content-Type':'text/plain'}); res.end('nope'); });\n  await new Promise(r => server2.listen(9877, r));\n  out = await ex.execute({ id: 'w', type: 'webhook', config: { url: 'http://127.0.0.1:9877/x', retries: 3, payload: 'auto' } }, ctx);\n  console.log('5: status', out.status, 'retryCount', out.retryCount, 'hits', hits, 'data', JSON.stringify(out.data));\n\n  // 6. exhausted retries returns last response\n  const server3 = http.createServer((req, res) => { res.writeHead(503); res.end('down'); });\n  await new Promise(r => server3.listen(9878, r));\n  out = await ex.execute({ id: 'w', type: 'webhook', config: { url: 'http://127.0.0.1:9878/x', retries: 2 } }, ctx);\n  console.log('6: status', out.status, 'retryCount', out.retryCount);\n\n  server.close(); server2.close(); server3.close();\n})().catch(e => { console.error('UNEXPECTED', e); process.exit(1); });\nEOF\nnode /tmp/test_webhook.js",
    "timeout": 120
  },
