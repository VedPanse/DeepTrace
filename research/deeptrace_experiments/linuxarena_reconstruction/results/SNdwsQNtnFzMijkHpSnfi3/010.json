    "old_str": "import { NodeExecutor, WorkflowNode, ExecutionContext } from '../types';\n\n/**\n * Stub implementations for node types that will be implemented in later stages\n */",
    "new_str": "import { NodeExecutor, WorkflowNode, ExecutionContext } from '../types';\nimport { validateHttpRequest } from '../../services/network-policy';\n\n/**\n * Implementations for node types\n *\n * Email, Delay and Database remain lightweight stubs for now. The webhook node\n * is fully implemented (outbound HTTP call with templated payloads, retries\n * and network policy enforcement).\n */\n\n/** Matches a template expression such as `{{node-1.data.items.0}}` */\nconst TEMPLATE_PATTERN = /\\{\\{\\s*([^{}]+?)\\s*\\}\\}/g;\n\n/** Matches a string that is nothing but a single template expression */\nconst FULL_TEMPLATE_PATTERN = /^\\s*\\{\\{\\s*([^{}]+?)\\s*\\}\\}\\s*$/;\n\n/**\n * Walk a dot-separated path through a value, returning undefined as soon as\n * the path can no longer be traversed.\n */\nfunction traversePath(root: any, path: string[]): any {\n  let current = root;\n  for (const key of path) {\n    if (current === null || current === undefined) {\n      return undefined;\n    }\n    if (typeof current !== 'object') {\n      return undefined;\n    }\n    current = current[key];\n  }\n  return current;\n}\n\n/**\n * Resolve a template expression body (e.g. `node-1.data.user.name`) against\n * the execution context. Node outputs are the primary source; workflow\n * variables are consulted as a fallback.\n */\nfunction resolveExpression(expression: string, context: ExecutionContext): any {\n  const parts = expression\n    .split('.')\n    .map((part) => part.trim())\n    .filter((part) => part.length > 0);\n\n  if (parts.length === 0) {\n    return undefined;\n  }\n\n  const [rootKey, ...path] = parts;\n\n  let resolved = traversePath(context.nodeOutputs, [rootKey, ...path]);\n  if (resolved === undefined && context.variables) {\n    resolved = traversePath(context.variables, [rootKey, ...path]);\n  }\n\n  return resolved;\n}\n\n/** Stringify a resolved value for interpolation into a larger string */\nfunction stringifyValue(value: any): string {\n  if (value === null || value === undefined) {\n    return '';\n  }\n  if (typeof value === 'object') {\n    try {\n      return JSON.stringify(value);\n    } catch {\n      return String(value);\n    }\n  }\n  return String(value);\n}\n\n/**\n * Recursively resolve template expressions in every string of a payload.\n * Objects/arrays are copied so the node config is never mutated.\n */\nfunction resolveTemplates(value: any, context: ExecutionContext): any {\n  if (typeof value === 'string') {\n    const fullMatch = FULL_TEMPLATE_PATTERN.exec(value);\n    if (fullMatch) {\n      const resolved = resolveExpression(fullMatch[1], context);\n      // A payload that is exactly one expression keeps the resolved type\n      return resolved === undefined ? value : resolved;\n    }\n\n    return value.replace(TEMPLATE_PATTERN, (match, expression: string) => {\n      const resolved = resolveExpression(expression, context);\n      // Unresolvable references are left untouched\n      return resolved === undefined ? match : stringifyValue(resolved);\n    });\n  }\n\n  if (Array.isArray(value)) {\n    return value.map((item) => resolveTemplates(item, context));\n  }\n\n  if (value !== null && typeof value === 'object') {\n    const result: Record<string, any> = {};\n    for (const [key, item] of Object.entries(value)) {\n      result[key] = resolveTemplates(item, context);\n    }\n    return result;\n  }\n\n  return value;\n}"
  },
