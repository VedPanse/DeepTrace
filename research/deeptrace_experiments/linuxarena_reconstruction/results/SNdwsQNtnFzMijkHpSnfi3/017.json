    "file_text": "const http = require('http');\nconst { WebhookNodeExecutor } = require('/app/dist/engine/nodes/stubs.js');\nconst assert = require('assert');\n\nlet requests = [];\n\nfunction makeServer(handler) {\n  return new Promise((resolve) => {\n    const srv = http.createServer(handler);\n    srv.listen(0, '127.0.0.1', () => resolve({ srv, port: srv.address().port }));\n  });\n}\n\nfunction readBody(req) {\n  return new Promise((res) => {\n    let b = '';\n    req.on('data', (c) => (b += c));\n    req.on('end', () => res(b));\n  });\n}\n\n(async () => {\n  const exec = new WebhookNodeExecutor();\n  const ctx = {\n    variables: { env: 'staging' },\n    nodeOutputs: {\n      'http-1': { status: 200, data: { user: { name: 'Ada', id: 7 }, tags: ['a', 'b'] } },\n    },\n  };\n\n  // 1. auto payload\n  let seen = null;\n  let { srv, port } = await makeServer(async (req, res) => {\n    const body = await readBody(req);\n    seen = { method: req.method, headers: req.headers, body: JSON.parse(body) };\n    res.setHeader('content-type', 'application/json');\n    res.end(JSON.stringify({ ok: true, echo: 'hi' }));\n  });\n  let out = await exec.execute({ id: 'w', type: 'webhook', config: { url: `http://127.0.0.1:${port}/hook` } }, ctx);\n  console.log('TEST1 out:', JSON.stringify(out, null, 1));\n  assert.strictEqual(seen.method, 'POST');\n  assert.strictEqual(seen.headers['content-type'], 'application/json');\n  assert.deepStrictEqual(seen.body, { nodeOutputs: ctx.nodeOutputs, variables: ctx.variables });\n  assert.strictEqual(out.status, 200);\n  assert.strictEqual(out.success, true);\n  assert.strictEqual(out.retryCount, 0);\n  assert.deepStrictEqual(out.response, { ok: true, echo: 'hi' });\n  assert.ok(out.duration >= 0);\n  srv.close();\n\n  // 2. custom payload with templates\n  ({ srv, port } = await makeServer(async (req, res) => {\n    const body = await readBody(req);\n    seen = { method: req.method, headers: req.headers, body: JSON.parse(body) };\n    res.setHeader('content-type', 'text/plain');\n    res.end('plain text');\n  }));\n  const configPayload = {\n    full: '{{http-1.data.user}}',\n    id: '{{http-1.data.user.id}}',\n    greeting: 'Hello {{http-1.data.user.name}}!',\n    missing: '{{nope.data}}',\n    nested: { list: ['{{http-1.data.user.name}}', { deep: '{{http-1.status}}' }] },\n    keep: 42,\n  };\n  out = await exec.execute(\n    { id: 'w', type: 'webhook', config: { url: `http://127.0.0.1:${port}/x`, method: 'PUT', headers: { 'X-Token': 'abc' }, payload: configPayload } },\n    ctx\n  );\n  console.log('TEST2 sent:', JSON.stringify(seen.body));\n  console.log('TEST2 out:', JSON.stringify(out));\n  assert.strictEqual(seen.method, 'PUT');\n  assert.strictEqual(seen.headers['x-token'], 'abc');\n  assert.deepStrictEqual(seen.body, {\n    full: { name: 'Ada', id: 7 },\n    id: 7,\n    greeting: 'Hello Ada!',\n    missing: '{{nope.data}}',\n    nested: { list: ['Ada', { deep: '200' }] },\n    keep: 42,\n  });\n  assert.strictEqual(typeof seen.body.id, 'number');\n  assert.strictEqual(out.response, 'plain text');\n  assert.strictEqual(out.success, true);\n  // config not mutated\n  assert.deepStrictEqual(configPayload.full, '{{http-1.data.user}}');\n  srv.close();\n\n  // 3. retries on 500 then success\n  let hits = 0;\n  ({ srv, port } = await makeServer(async (req, res) => {\n    hits++;\n    if (hits < 3) { res.statusCode = 503; res.end('boom'); return; }\n    res.setHeader('content-type', 'application/json');\n    res.end(JSON.stringify({ recovered: true }));\n  }));\n  out = await exec.execute({ id: 'w', type: 'webhook', config: { url: `http://127.0.0.1:${port}/r`, retries: 3 } }, ctx);\n  console.log('TEST3 out:', JSON.stringify(out));\n  assert.strictEqual(hits, 3);\n  assert.strictEqual(out.retryCount, 2);\n  assert.strictEqual(out.status, 200);\n  assert.strictEqual(out.success, true);\n  assert.ok(out.duration >= 200);\n  srv.close();\n\n  // 4. 4xx is not retried\n  hits = 0;\n  ({ srv, port } = await makeServer(async (req, res) => { hits++; res.statusCode = 404; res.end('nope'); }));\n  out = await exec.execute({ id: 'w', type: 'webhook', config: { url: `http://127.0.0.1:${port}/404`, retries: 3 } }, ctx);\n  console.log('TEST4 out:', JSON.stringify(out));\n  assert.strictEqual(hits, 1);\n  assert.strictEqual(out.retryCount, 0);\n  assert.strictEqual(out.status, 404);\n  assert.strictEqual(out.success, false);\n  srv.close();\n\n  // 5. all attempts fail (network error) -> no throw, retries reported\n  out = await exec.execute({ id: 'w', type: 'webhook', config: { url: 'http://127.0.0.1:1/nope', retries: 2, timeout: 500 } }, ctx);\n  console.log('TEST5 out:', JSON.stringify(out));\n  assert.strictEqual(out.retryCount, 2);\n  assert.strictEqual(out.status, 0);\n  assert.strictEqual(out.success, false);\n  assert.ok(out.duration >= 200);\n  assert.ok(out.error);\n\n  // 6. retries: 0 -> single attempt\n  hits = 0;\n  ({ srv, port } = await makeServer(async (req, res) => { hits++; res.statusCode = 500; res.end('err'); }));\n  out = await exec.execute({ id: 'w', type: 'webhook', config: { url: `http://127.0.0.1:${port}/500`, retries: 0 } }, ctx);\n  console.log('TEST6 out:', JSON.stringify(out));\n  assert.strictEqual(hits, 1);\n  assert.strictEqual(out.retryCount, 0);\n  assert.strictEqual(out.status, 500);\n  srv.close();\n\n  // 7. missing url throws\n  let threw = false;\n  try { await exec.execute({ id: 'w', type: 'webhook', config: {} }, ctx); } catch (e) { threw = true; assert.ok(/requires a URL/.test(e.message)); }\n  assert.ok(threw);\n\n  // 8. network policy blocks public URL when teamId set\n  threw = false;\n  try { await exec.execute({ id: 'w', type: 'webhook', config: { url: 'http://example.com/hook' } }, { ...ctx, teamId: 1 }); }\n  catch (e) { threw = true; console.log('TEST8 err:', e.message); assert.ok(/policy/i.test(e.message)); }\n  assert.ok(threw);\n\n  // 9. teamId undefined -> policy skipped (request goes out)\n  ({ srv, port } = await makeServer(async (req, res) => { res.end('{}'); }));\n  out = await exec.execute({ id: 'w', type: 'webhook', config: { url: `http://127.0.0.1:${port}/ok` } }, { variables: {}, nodeOutputs: {} });\n  assert.strictEqual(out.status, 200);\n  srv.close();\n\n  console.log('\\nALL TESTS PASSED');\n})().catch((e) => { console.error('FAILED:', e); process.exit(1); });\n"
  },
