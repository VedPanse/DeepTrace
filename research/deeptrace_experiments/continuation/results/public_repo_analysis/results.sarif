{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "AgentSecBench",
          "version": "0.2.0",
          "informationUri": "https://github.com/A1LinLin1/AgentSecBench",
          "rules": [
            {
              "id": "agentsecbench/credential_access",
              "name": "credential_access",
              "shortDescription": {
                "text": "Credential Access"
              },
              "fullDescription": {
                "text": "Credential-like environment access"
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "precision": "high",
                "tags": [
                  "security",
                  "llm-agent",
                  "static-analysis",
                  "credential_access"
                ]
              }
            },
            {
              "id": "agentsecbench/database_access",
              "name": "database_access",
              "shortDescription": {
                "text": "Database Access"
              },
              "fullDescription": {
                "text": "Database client or query API reference"
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "precision": "medium",
                "tags": [
                  "security",
                  "llm-agent",
                  "static-analysis",
                  "database_access"
                ]
              }
            },
            {
              "id": "agentsecbench/filesystem_read",
              "name": "filesystem_read",
              "shortDescription": {
                "text": "Filesystem Read"
              },
              "fullDescription": {
                "text": "JavaScript or TypeScript file-read operation"
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "precision": "high",
                "tags": [
                  "security",
                  "llm-agent",
                  "static-analysis",
                  "filesystem_read"
                ]
              }
            },
            {
              "id": "agentsecbench/network_access",
              "name": "network_access",
              "shortDescription": {
                "text": "Network Access"
              },
              "fullDescription": {
                "text": "Direct socket connection; JavaScript or TypeScript HTTP request"
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "precision": "high",
                "tags": [
                  "security",
                  "llm-agent",
                  "static-analysis",
                  "network_access"
                ]
              }
            }
          ]
        }
      },
      "originalUriBaseIds": {
        "%SRCROOT%": {
          "uri": "./"
        }
      },
