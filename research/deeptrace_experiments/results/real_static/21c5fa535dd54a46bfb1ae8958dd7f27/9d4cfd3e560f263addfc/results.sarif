{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "AgentSecBench",
          "version": "0.2.0",
          "informationUri": "https://github.com/A1LinLin1/AgentSecBench",
          "rules": [
            {
              "id": "agentsecbench/network_access",
              "name": "network_access",
              "shortDescription": {
                "text": "Network Access"
              },
              "fullDescription": {
                "text": "JavaScript or TypeScript HTTP request"
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "precision": "high",
                "tags": [
                  "security",
                  "llm-agent",
                  "static-analysis",
                  "network_access"
                ]
              }
            }
          ]
        }
      },
      "originalUriBaseIds": {
        "%SRCROOT%": {
          "uri": "./"
        }
      },
      "results": [
        {
          "ruleId": "agentsecbench/network_access",
          "level": "warning",
          "message": {
            "text": "network access candidate in <module>"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "2fb32857dcb0.ts",
                  "uriBaseId": "%SRCROOT%"
                },
                "region": {
                  "startLine": 92,
                  "endLine": 92
                }
              }
            }
          ],
          "partialFingerprints": {
            "agentsecbenchFindingId/v1": "ASB-0EAE447F0373DE22",
            "agentsecbenchStableFingerprint/v1": "ASBFP-2185ED911F1FEF63C4A736EB"
          },
          "properties": {
            "candidateId": "ASB-0EAE447F0373DE22",
            "fingerprint": "ASBFP-2185ED911F1FEF63C4A736EB",
            "confidence": "high",
            "detectors": [
              "js_http_client"
            ],
            "reviewStatus": "candidate",
            "claimBoundary": "static candidate; review required; not a vulnerability claim"
          }
        }
      ],
      "properties": {
        "claimBoundary": "candidate discovery output; not vulnerability ground truth",
        "sourceExecutionUsed": false
      }
    }
  ]
}
