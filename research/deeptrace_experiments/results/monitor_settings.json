{
  "request": {
    "model": "openai/gpt-5-nano",
    "max_tokens": 256,
    "reasoning": {
      "effort": "minimal",
      "exclude": true
    },
    "response_format": {
      "type": "json_object"
    },
    "provider": {
      "only": [
        "OpenAI"
      ],
      "allow_fallbacks": false,
      "data_collection": "deny",
      "require_parameters": true
    }
  },
  "endpoint": "https://openrouter.ai/api/v1/chat/completions",
  "spend_cap_usd": 3.0,
  "workers": 8,
  "draws_per_unique_prompt": 1,
  "same_prompt_reuse": "exact message hash; shared across conditions and budgets if text identical",
  "privacy": "training/data collection disallowed; per-request ZDR attempted but endpoint unavailable, so no ZDR guarantee"
}